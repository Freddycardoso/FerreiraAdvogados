---
interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Ferreira Advogados | Dr. Charles Santos Ferreira - OAB/MG 91.989",
  description = "Escritório de advocacia especializado em Direito Cível, Criminal, Trabalhista e Previdenciário em Passos - MG e região sul-mineira. Atendimento ágil e consultoria jurídica de alto padrão."
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site || "https://ferreiraadvogados.com.br");

const schemaData = {
  "@context": "https://schema.org",
  "@type": "LegalService",
  "name": "Ferreira Advogados",
  "telephone": "+55-35-99753-3336",
  "address": {
    "@type": "PostalAddress",
    "addressLocality": "Passos",
    "addressRegion": "MG",
    "addressCountry": "BR"
  },
  "founder": {
    "@type": "Person",
    "name": "Dr. Charles Santos Ferreira",
    "jobTitle": "Advogado",
    "identifier": "OAB/MG 91.989"
  },
  "areaServed": {
    "@type": "AdministrativeArea",
    "name": "Passos e Região Sul de Minas Gerais"
  },
  "knowsAbout": [
    "Direito Cível",
    "Direito Criminal",
    "Direito Trabalhista",
    "Direito Previdenciário"
  ]
};
---

<!doctype html>
<html lang="pt-BR" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <!-- SEO Meta Tags -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph / Facebook / WhatsApp -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content="pt_BR" />

    <!-- Google Fonts Preconnect & Optimization (Cinzel & Literata Editorial) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cinzel:wght@500;600;700;800&family=Literata:ital,opsz,wght@0,7..72,300;0,7..72,400;0,7..72,500;0,7..72,600;1,7..72,400&display=swap"
      rel="stylesheet"
    />

    <!-- Schema JSON-LD (LegalService) -->
    <script type="application/ld+json" set:html={JSON.stringify(schemaData)} />

    <style is:global>
      :root {
        --font-serif: 'Cinzel', Georgia, serif;
        --font-body: 'Literata', Georgia, serif;
      }

      body {
        font-family: var(--font-body);
      }

      .font-serif {
        font-family: var(--font-serif);
      }

      /* Base transition styles for scroll reveals (Emil Kowalski: tight 14px delta, punchy ease-out) */
      .reveal-on-scroll {
        transition-property: opacity, transform;
        transition-duration: 380ms;
        transition-timing-function: cubic-bezier(0.23, 1, 0.32, 1);
        will-change: opacity, transform;
      }

      /* Efeito 3D Smoked Glass (Vidro Fumê de Alto Padrão) */
      .glass-panel {
        background: linear-gradient(135deg, rgba(255, 255, 255, 0.05) 0%, rgba(255, 255, 255, 0.01) 100%), rgba(9, 14, 26, 0.65);
        backdrop-filter: blur(16px);
        -webkit-backdrop-filter: blur(16px);
        border: 1px solid rgba(255, 255, 255, 0.09);
        box-shadow: 0 20px 45px -15px rgba(0, 0, 0, 0.75), inset 0 1px 0 0 rgba(255, 255, 255, 0.12);
      }

      .glass-panel:hover {
        border-color: rgba(203, 213, 225, 0.35);
        box-shadow: 0 25px 55px -10px rgba(2, 6, 23, 0.9), inset 0 1px 0 0 rgba(255, 255, 255, 0.25);
      }
    </style>
  </head>

  <body class="bg-[#050811] text-slate-100 antialiased selection:bg-slate-800 selection:text-slate-100 min-h-screen flex flex-col relative overflow-x-hidden">
    <!-- Iluminação Arquitetônica 3D (Midnight Navy + Focos de Luz Nobre) -->
    <div class="fixed inset-0 pointer-events-none z-0 overflow-hidden" aria-hidden="true">
      <!-- Foco Superior de Luz Direcional (Estilo Luminária de Gabinete) -->
      <div class="absolute -top-[160px] left-1/2 -translate-x-1/2 w-[900px] sm:w-[1250px] h-[650px] bg-gradient-to-b from-blue-900/22 via-slate-800/14 to-transparent blur-[140px] rounded-full"></div>
      
      <!-- Foco Lateral Noturno Esquerdo (Profundidade Azul-Petróleo) -->
      <div class="absolute top-[35%] -left-[140px] w-[550px] h-[650px] bg-sky-950/18 blur-[160px] rounded-full"></div>
      
      <!-- Foco Lateral Noturno Direito (Equilíbrio de Sombra e Chumbo) -->
      <div class="absolute top-[65%] -right-[150px] w-[650px] h-[750px] bg-indigo-950/16 blur-[170px] rounded-full"></div>
      
      <!-- Vinheta Radial de Profundidade Periférica -->
      <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_center,transparent_0%,rgba(3,5,11,0.65)_100%)]"></div>
    </div>

    <!-- Conteúdo Principal em Camada Superior z-10 -->
    <div class="relative z-10 flex flex-col min-h-screen">
      <slot />
    </div>

    <!-- Native Scroll Reveal (Zero Runtime Overhead, Emil Kowalski Snappy Physics) -->
    <script is:inline>
      const setupScrollReveal = () => {
        const revealElements = document.querySelectorAll('.reveal-on-scroll');
        if (!revealElements.length) return;

        const observer = new IntersectionObserver(
          (entries, obs) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.remove('opacity-0', 'translate-y-3.5', 'translate-y-6', 'scale-[0.99]');
                entry.target.classList.add('opacity-100', 'translate-y-0', 'scale-100');
                obs.unobserve(entry.target);
              }
            });
          },
          {
            root: null,
            rootMargin: '0px 0px -40px 0px',
            threshold: 0.1
          }
        );

        revealElements.forEach((el) => observer.observe(el));
      };

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', setupScrollReveal);
      } else {
        setupScrollReveal();
      }

      document.addEventListener('astro:page-load', setupScrollReveal);
    </script>
  </body>
</html>
