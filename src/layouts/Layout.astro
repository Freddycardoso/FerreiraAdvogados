---
interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Advogado em Passos - MG | Criminal, Trabalhista, Previdenciário e Cível | Ferreira Advogados",
  description = "Advogado em Passos - MG para prisão, inquérito, demissão injusta, aposentadoria negada pelo INSS e disputas cíveis. Fale agora com o Dr. Charles Santos Ferreira (OAB/MG 91.989) pelo WhatsApp."
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site || "https://charlesferreiraadvogado.com.br");

const schemaData = {
  "@context": "https://schema.org",
  "@type": "LegalService",
  "name": "Ferreira Advogados",
  "telephone": "+55-35-99753-3336",
  "address": {
    "@type": "PostalAddress",
    "addressLocality": "Passos",
    "addressRegion": "MG",
    "addressCountry": "BR"
  },
  "founder": {
    "@type": "Person",
    "name": "Dr. Charles Santos Ferreira",
    "jobTitle": "Advogado",
    "identifier": "OAB/MG 91.989"
  },
  "areaServed": {
    "@type": "AdministrativeArea",
    "name": "Passos e Região Sul de Minas Gerais"
  },
  "knowsAbout": [
    "Direito Criminal",
    "Direito Trabalhista",
    "Direito Previdenciário",
    "Direito Cível"
  ]
};
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#0F131A" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:site_name" content="Ferreira Advogados" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalURL} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <!-- SEO Essencial -->
    <meta name="robots" content="index, follow" />
    <meta name="author" content="Dr. Charles Santos Ferreira" />

    <!-- GEO Tags -->
    <meta name="geo.region" content="BR-MG" />
    <meta name="geo.placename" content="Passos" />
    <meta name="geo.position" content="-20.7188;-46.6081" />
    <meta name="ICBM" content="-20.7188, -46.6081" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,500;0,6..72,600;0,6..72,700;1,6..72,400;1,6..72,500&family=Libre+Franklin:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />

    <script type="application/ld+json" set:html={JSON.stringify(schemaData)} />

    <style is:global>
      html { scroll-behavior: smooth; scroll-padding-top: 5.5rem; }
      @media (prefers-reduced-motion: reduce) {
        html { scroll-behavior: auto; }
        * { animation: none !important; transition: none !important; }
      }
      body { font-family: 'Libre Franklin', system-ui, sans-serif; }
      :focus-visible { outline: 2px solid #C9CED6; outline-offset: 3px; }
      .on-light :focus-visible { outline-color: #7A1F2E; }
    </style>
  </head>

  <body class="bg-ink text-prata antialiased min-h-screen flex flex-col selection:bg-vinho selection:text-white">
    <slot />
  </body>
</html>
