---
// src/components/About.astro
// Seção "Como funciona" (sequência real: numeração justificada) + apresentação do advogado
const wa = "https://wa.me/5535997533336?text=Ol%C3%A1%2C%20Dr.%20Charles.%20Quero%20conversar%20sobre%20o%20meu%20caso.";

const steps = [
  { title: "Você conta o caso", text: "Por WhatsApp ou telefone, sem formulário e sem burocracia. Basta dizer o que aconteceu e enviar os documentos que tiver." },
  { title: "O advogado analisa", text: "O Dr. Charles avalia seu caso pessoalmente, aponta os riscos, os prazos e os caminhos possíveis, sem promessa de resultado." },
  { title: "Você decide com clareza", text: "Explicamos honorários e próximos passos antes de qualquer contratação. Só avança quem entendeu e concordou." },
];
---

<section id="como-funciona" class="bg-ink2 border-y border-white/15">
  <div class="max-w-7xl mx-auto px-5 lg:px-8 py-20 lg:py-28 grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16">
    <div class="lg:col-span-4">
      <h2 class="font-serif text-4xl font-semibold text-white leading-[1.1] tracking-tight">
        Como funciona o primeiro contato
      </h2>
      <p class="mt-5 text-prata leading-relaxed">
        Sem linguagem jurídica difícil. Você entende seu caso antes de decidir qualquer coisa.
      </p>
    </div>

    <ol class="lg:col-span-8 border-t border-white/15">
      {steps.map((s, i) => (
        <li class="grid grid-cols-[3rem_1fr] sm:grid-cols-[4rem_1fr] gap-4 py-8 border-b border-white/15">
          <span class="font-serif text-3xl text-prata tabular-nums">{i + 1}</span>
          <div>
            <h3 class="font-serif text-2xl text-white font-semibold">{s.title}</h3>
            <p class="mt-2 text-prata leading-relaxed max-w-[58ch]">{s.text}</p>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>

<section id="advogado" class="on-light bg-stone text-ink">
  <div class="max-w-7xl mx-auto px-5 lg:px-8 py-20 lg:py-28 grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16">
    <div class="lg:col-span-5">
      <h2 class="font-serif text-4xl sm:text-5xl font-semibold leading-[1.1] tracking-tight">
        Quem cuida do seu caso é o próprio advogado.
      </h2>
    </div>

    <div class="lg:col-span-7">
      <div class="space-y-5 text-[17px] leading-[1.75] text-[#2B303B] max-w-[62ch]">
        <p>
          A Ferreira Advogados é conduzida por <strong class="font-semibold text-ink">Dr. Charles Santos Ferreira, OAB/MG 91.989</strong>, com atuação em Passos e nas comarcas do Sul de Minas Gerais.
        </p>
        <p>
          Aqui não existe fila de atendimento nem caso entregue a quem você nunca viu. Você fala com quem vai assinar sua defesa, recebe notícias do andamento em linguagem simples e sabe sempre em que pé está seu processo.
        </p>
        <p>
          Tudo o que você contar fica protegido pelo sigilo profissional.
        </p>
      </div>

      <dl class="mt-10 grid sm:grid-cols-3 gap-6 border-t-2 border-ink pt-6 text-[15px]">
        <div>
          <dt class="font-semibold text-vinho">Registro</dt>
          <dd class="mt-1 text-[#2B303B]">OAB/MG 91.989</dd>
        </div>
        <div>
          <dt class="font-semibold text-vinho">Sede</dt>
          <dd class="mt-1 text-[#2B303B]">Passos, Minas Gerais</dd>
        </div>
        <div>
          <dt class="font-semibold text-vinho">Atuação</dt>
          <dd class="mt-1 text-[#2B303B]">TJMG, TRF6, TRT3, STJ e STF</dd>
        </div>
      </dl>

      <a
        href={wa}
        target="_blank"
        rel="noopener noreferrer"
        class="mt-10 inline-flex items-center justify-center px-7 py-4 bg-vinho hover:bg-vinhoescuro text-white font-semibold transition-colors active:translate-y-px"
      >
        Conversar com o Dr. Charles
      </a>
    </div>
  </div>
</section>
