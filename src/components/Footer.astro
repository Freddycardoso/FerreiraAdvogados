---
// src/components/Footer.astro
const whatsappUrl = "https://wa.me/5535997533336?text=Ol%C3%A1%2C%20Dr.%20Charles.%20Vim%20pelo%20site%20e%20gostaria%20de%20agendar%20uma%20consulta%20jur%C3%ADdica";
const currentYear = new Date().getFullYear();
---

<footer id="contato" class="relative bg-[#04060d]/90 text-slate-300 border-t border-white/10 pt-20 pb-12 overflow-hidden backdrop-blur-xl">
  <!-- Efeito Sutil de Iluminação de Fundo Midnight Navy -->
  <div class="pointer-events-none absolute bottom-0 left-1/2 -translate-x-1/2 w-[800px] h-[280px] bg-blue-950/20 blur-[140px] rounded-full"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <!-- Grid Principal do Rodapé -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-12 gap-12 lg:gap-16 pb-16 border-b border-white/10">
      
      <!-- Coluna Institucional (Logo, OAB e Posicionamento) -->
      <div class="lg:col-span-5 space-y-5">
        <a href="#" class="inline-block group" aria-label="Ferreira Advogados">
          <span class="font-serif text-2xl font-bold tracking-[0.2em] text-white uppercase group-hover:text-slate-200 transition-colors">
            Ferreira Advogados
          </span>
          <span class="block text-xs tracking-[0.25em] text-zinc-400 uppercase font-medium mt-1">
            Dr. Charles Santos Ferreira &bull; OAB/MG 91.989
          </span>
        </a>

        <p class="text-xs sm:text-sm text-slate-300 font-normal leading-relaxed max-w-md">
          Assessoria jurídica consultiva e contenciosa de alto padrão, combinando discrição absoluta, rigor técnico processual e combatividade intransigente para clientes de Passos e de todo o Sul de Minas Gerais.
        </p>

        <div class="pt-2">
          <a
            href={whatsappUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 text-xs uppercase tracking-[0.16em] font-semibold text-white hover:text-zinc-300 transition-colors py-1 border-b border-zinc-600 hover:border-white active:scale-[0.98]"
          >
            <span>Iniciar Atendimento via WhatsApp</span>
            <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          </a>
        </div>
      </div>

      <!-- Coluna de Áreas de Atuação -->
      <div class="lg:col-span-3 space-y-4">
        <h4 class="font-serif text-sm font-bold uppercase tracking-[0.2em] text-white">
          Áreas de Atuação
        </h4>
        <ul class="space-y-2.5 text-xs text-zinc-400">
          <li>
            <a href="#atuacao" class="hover:text-white transition-colors duration-150 flex items-center gap-2">
              <span class="w-1 h-1 rounded-full bg-zinc-600"></span>
              Direito Cível & Contratos
            </a>
          </li>
          <li>
            <a href="#atuacao" class="hover:text-white transition-colors duration-150 flex items-center gap-2">
              <span class="w-1 h-1 rounded-full bg-zinc-600"></span>
              Direito Criminal & Custódias
            </a>
          </li>
          <li>
            <a href="#atuacao" class="hover:text-white transition-colors duration-150 flex items-center gap-2">
              <span class="w-1 h-1 rounded-full bg-zinc-600"></span>
              Direito Trabalhista
            </a>
          </li>
          <li>
            <a href="#atuacao" class="hover:text-white transition-colors duration-150 flex items-center gap-2">
              <span class="w-1 h-1 rounded-full bg-zinc-600"></span>
              Direito Previdenciário (INSS)
            </a>
          </li>
        </ul>
      </div>

      <!-- Coluna de Localização e Atendimento -->
      <div class="lg:col-span-4 space-y-4">
        <h4 class="font-serif text-sm font-bold uppercase tracking-[0.2em] text-white">
          Sede & Jurisdição
        </h4>
        
        <div class="space-y-3 text-xs text-zinc-400">
          <div class="flex items-start gap-3">
            <svg class="w-4 h-4 text-zinc-300 mt-0.5 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z" />
            </svg>
            <p class="leading-relaxed">
              <strong class="text-slate-200 font-medium">Atendimento Presencial:</strong><br />
              Passos &bull; Minas Gerais &bull; Brasil
            </p>
          </div>

          <div class="flex items-start gap-3">
            <svg class="w-4 h-4 text-zinc-300 mt-0.5 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 21a9.004 9.004 0 008.716-6.747M12 21a9.004 9.004 0 01-8.716-6.747M12 21c2.485 0 4.5-4.03 4.5-9S14.485 3 12 3m0 18c-2.485 0-4.5-4.03-4.5-9S9.515 3 12 3m0 0a8.997 8.997 0 017.843 4.582M12 3a8.997 8.997 0 00-7.843 4.582m15.686 0A11.953 11.953 0 0112 10.5c-2.998 0-5.74-1.1-7.843-2.918m15.686 0A8.959 8.959 0 0121 12c0 .778-.099 1.533-.284 2.253m0 0A17.919 17.919 0 0112 16.5c-3.162 0-6.133-.815-8.716-2.247m0 0A9.015 9.015 0 013 12c0-.778.099-1.533.284-2.253" />
            </svg>
            <p class="leading-relaxed">
              <strong class="text-slate-200 font-medium">Representação Processual:</strong><br />
              Tribunal de Justiça de Minas Gerais (TJMG), TRF6, TRT3, Superior Tribunal de Justiça (STJ) e Supremo Tribunal Federal (STF).
            </p>
          </div>

          <div class="flex items-center gap-3 pt-1">
            <svg class="w-4 h-4 text-emerald-500 flex-shrink-0" viewBox="0 0 24 24" fill="currentColor">
              <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/>
            </svg>
            <span class="text-white font-medium">(35) 99753-3336</span>
          </div>

          <div class="flex items-center gap-3">
            <svg class="w-4 h-4 text-zinc-400 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75" />
            </svg>
            <a href="mailto:contato@ferreiraadvogados.com.br" class="text-zinc-300 hover:text-white transition-colors underline-offset-4 hover:underline">
              contato@ferreiraadvogados.com.br
            </a>
          </div>

          <div class="pt-2">
            <a
              href="https://cna.oab.org.br/"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1.5 text-[11px] text-zinc-400 hover:text-zinc-200 transition-colors uppercase tracking-wider"
            >
              <span>Consultar Cadastro Nacional (CNA / OAB)</span>
              <svg class="w-3 h-3 text-zinc-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
              </svg>
            </a>
          </div>
        </div>
      </div>

    </div>

    <!-- Bloco de Conformidade com o Código de Ética e Disciplina da OAB -->
    <div class="pt-8 pb-8 border-b border-white/5 text-[11px] leading-relaxed text-slate-400 font-normal">
      <p>
        <strong class="text-zinc-300 font-medium uppercase tracking-wider">Aviso Ético-Institucional:</strong>
        Este sítio eletrônico tem caráter estritamente informativo e educativo, em estrita conformidade com as diretrizes do Provimento nº 205/2021 do Conselho Federal da Ordem dos Advogados do Brasil (CFOAB) e com o Código de Ética e Disciplina da OAB. As informações veiculadas não constituem orientação jurídica vinculante nem configuram captação indevida de clientela ou publicidade mercantil.
      </p>
    </div>

    <!-- Linha Final de Copyright -->
    <div class="pt-8 flex flex-col sm:flex-row items-center justify-between text-xs text-zinc-500 gap-4">
      <p>
        &copy; {currentYear} Ferreira Advogados. Dr. Charles Santos Ferreira (OAB/MG 91.989). Todos os direitos reservados.
      </p>
      <p class="text-[11px] tracking-wider uppercase text-zinc-600">
        Passos - MG &bull; Brasil
      </p>
    </div>
  </div>
</footer>

<!-- Botão Flutuante de WhatsApp (Mobile-First / Conversão Imediata) -->
<aside class="fixed bottom-6 right-6 z-50 flex items-center group" aria-label="Contato direto via WhatsApp">
  <!-- Tooltip de Convite Elegante para Desktop -->
  <div class="hidden sm:flex items-center mr-3 px-3.5 py-1.5 rounded-full bg-neutral-900/95 border border-white/15 backdrop-blur-md shadow-xl text-xs text-zinc-200 font-medium tracking-wide opacity-0 translate-x-3 pointer-events-none group-hover:opacity-100 group-hover:translate-x-0 transition-[opacity,transform] duration-200 ease-out">
    <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 mr-2"></span>
    Consulta com Dr. Charles
  </div>

  <a
    href={whatsappUrl}
    target="_blank"
    rel="noopener noreferrer"
    class="relative flex items-center justify-center w-14 h-14 rounded-full bg-gradient-to-tr from-emerald-700 via-emerald-600 to-teal-500 text-white shadow-[0_4px_25px_rgba(16,185,129,0.4)] hover:shadow-[0_6px_35px_rgba(16,185,129,0.6)] hover:scale-105 active:scale-95 transition-transform duration-160 ease-out"
    aria-label="Abrir WhatsApp para consulta jurídica com Dr. Charles Santos Ferreira"
  >
    <!-- Ondas de Pulso Suaves -->
    <span class="absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-30 animate-ping"></span>
    
    <!-- Ícone WhatsApp Oficial -->
    <svg class="w-7 h-7 relative z-10" viewBox="0 0 24 24" fill="currentColor">
      <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/>
    </svg>
  </a>
</aside>
