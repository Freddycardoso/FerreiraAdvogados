---
// src/components/Footer.astro
const whatsappUrl = "https://wa.me/5535997533336?text=Ol%C3%A1%2C%20Dr.%20Charles.%20Vim%20pelo%20site%20e%20preciso%20de%20orienta%C3%A7%C3%A3o%20jur%C3%ADdica.";
const currentYear = new Date().getFullYear();
---

<footer id="contato" class="bg-ink">
  <div class="max-w-7xl mx-auto px-5 lg:px-8 pt-20 pb-10">

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 pb-14 border-b border-white/15">
      <div class="lg:col-span-7">
        <h2 class="font-serif text-4xl sm:text-5xl font-semibold text-white leading-[1.1] tracking-tight">
          Seu prazo está correndo. Fale com o advogado hoje.
        </h2>
        <p class="mt-5 text-lg text-prata max-w-xl leading-relaxed">
          Descreva o que aconteceu. Você recebe uma orientação inicial sobre riscos, prazos e caminhos possíveis.
        </p>
        <a
          href={whatsappUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="mt-9 inline-flex items-center justify-center px-8 py-4 bg-vinho hover:bg-vinhoescuro text-white text-base font-semibold transition-colors active:translate-y-px"
        >
          Chamar no WhatsApp agora
        </a>
      </div>

      <div class="lg:col-span-5 lg:pl-12 lg:border-l lg:border-white/15 space-y-6 text-[15px]">
        <div>
          <p class="text-sm font-semibold text-white">Telefone e WhatsApp</p>
          <a href="tel:+5535997533336" class="mt-1 block font-serif text-3xl text-white tabular-nums hover:text-prata transition-colors">(35) 99753-3336</a>
        </div>
        <div>
          <p class="text-sm font-semibold text-white">E-mail</p>
          <a href="mailto:contato@ferreiraadvogados.com.br" class="mt-1 block text-prata hover:text-white underline underline-offset-4 decoration-white/30 transition-colors">contato@ferreiraadvogados.com.br</a>
        </div>
        <div>
          <p class="text-sm font-semibold text-white">Atendimento</p>
          <p class="mt-1 text-prata leading-relaxed">Passos, Minas Gerais, e região do Sul de Minas. Representação no TJMG, TRF6, TRT3, STJ e STF.</p>
        </div>
      </div>
    </div>

    <div class="pt-8 text-xs leading-relaxed text-prata/70 max-w-4xl">
      <p>
        <strong class="font-semibold text-prata">Aviso:</strong>
        Este site tem caráter exclusivamente informativo, conforme o Provimento nº 205/2021 do Conselho Federal da OAB e o Código de Ética e Disciplina. O conteúdo não constitui aconselhamento jurídico nem promessa de resultado. Cada caso exige análise individual.
      </p>
    </div>

    <div class="mt-8 pt-6 border-t border-white/15 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 text-xs text-prata/70">
      <p>&copy; {currentYear} Ferreira Advogados. Dr. Charles Santos Ferreira, OAB/MG 91.989.</p>
      <a href="https://cna.oab.org.br/" target="_blank" rel="noopener noreferrer" class="hover:text-white underline underline-offset-4 decoration-white/30 transition-colors">
        Consultar cadastro na OAB
      </a>
    </div>
  </div>
</footer>

<!-- Botão flutuante de WhatsApp: discreto e funcional -->
<a
  href={whatsappUrl}
  target="_blank"
  rel="noopener noreferrer"
  aria-label="Falar com o Dr. Charles pelo WhatsApp"
  class="fixed bottom-5 right-5 z-50 inline-flex items-center gap-2.5 pl-4 pr-5 py-3 bg-vinho hover:bg-vinhoescuro text-white text-sm font-semibold shadow-lg shadow-black/40 transition-colors active:translate-y-px"
>
  <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
    <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/>
  </svg>
  <span>WhatsApp</span>
</a>
