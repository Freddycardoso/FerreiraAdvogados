---
// src/components/Hero.astro
const wa = (msg: string) => `https://wa.me/5535997533336?text=${encodeURIComponent(msg)}`;

const situations = [
  {
    label: "Fui preso, ou um familiar foi preso",
    msg: "Olá, Dr. Charles. Preciso de ajuda urgente: houve uma prisão ou investigação criminal.",
  },
  {
    label: "Fui demitido sem receber o que é meu",
    msg: "Olá, Dr. Charles. Fui demitido e acredito que não recebi meus direitos trabalhistas.",
  },
  {
    label: "O INSS negou ou cortou meu benefício",
    msg: "Olá, Dr. Charles. O INSS negou ou cortou meu benefício e preciso de orientação.",
  },
  {
    label: "Estou sendo processado ou preciso cobrar alguém",
    msg: "Olá, Dr. Charles. Tenho um problema cível (processo, contrato, cobrança ou indenização).",
  },
];
---

<section id="inicio" class="bg-ink">
  <div class="max-w-7xl mx-auto px-5 lg:px-8 py-16 sm:py-20 lg:py-28 grid grid-cols-1 lg:grid-cols-12 gap-14 lg:gap-16">

    <div class="lg:col-span-7">
      <h1 class="font-serif text-[2.15rem] sm:text-5xl lg:text-[3.6rem] font-semibold text-white leading-[1.08] tracking-tight">
        Advogado em Passos, MG, para quando sua liberdade, seu emprego ou seu sustento estão em risco.
      </h1>

      <p class="mt-7 max-w-xl text-lg text-prata leading-relaxed">
        Prazos judiciais não esperam. Cada dia sem advogado pode custar uma defesa, um direito ou um benefício. Conte seu caso agora e saiba, com clareza, o que pode ser feito.
      </p>

      <div class="mt-10 flex flex-col sm:flex-row sm:items-center gap-5">
        <a
          href={wa("Olá, Dr. Charles. Vim pelo site e preciso de orientação jurídica urgente.")}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center gap-3 px-8 py-4 bg-vinho hover:bg-vinhoescuro text-white text-base font-semibold transition-colors active:translate-y-px"
        >
          Contar meu caso no WhatsApp
        </a>
        <a href="tel:+5535997533336" class="text-white font-semibold text-lg tabular-nums underline underline-offset-4 decoration-white/40 hover:decoration-white transition-colors">
          ou ligue (35) 99753-3336
        </a>
      </div>

      <p class="mt-6 text-sm text-prata/80">
        Primeira conversa sem compromisso. Sigilo profissional garantido por lei.
      </p>

      <p class="mt-14 pt-6 border-t border-white/15 text-sm text-prata/80 max-w-xl">
        Dr. Charles Santos Ferreira, OAB/MG 91.989. Atendimento em Passos e região sul-mineira.
      </p>
    </div>

    <div class="lg:col-span-5 lg:border-l lg:border-white/15 lg:pl-12">
      <h2 class="font-serif text-2xl text-white font-semibold">Qual é a sua situação?</h2>
      <p class="mt-2 text-prata text-[15px]">Toque na que mais se parece com a sua. A conversa já abre com o assunto certo.</p>

      <ul class="mt-6 border-t border-white/15">
        {situations.map((s) => (
          <li class="border-b border-white/15">
            <a
              href={wa(s.msg)}
              target="_blank"
              rel="noopener noreferrer"
              class="group flex items-center justify-between gap-4 py-5 text-white hover:text-prata transition-colors"
            >
              <span class="font-serif text-xl leading-snug">{s.label}</span>
              <svg class="w-5 h-5 shrink-0 text-prata group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
              </svg>
            </a>
          </li>
        ))}
      </ul>
    </div>

  </div>
</section>
