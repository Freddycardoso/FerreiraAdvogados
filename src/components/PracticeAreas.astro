---
// src/components/PracticeAreas.astro
const wa = (msg: string) => `https://wa.me/5535997533336?text=${encodeURIComponent(msg)}`;

const areas = [
  {
    area: "Direito Criminal",
    pain: "Prisão em flagrante, inquérito ou processo criminal",
    text: "Nas primeiras horas se define muito do que vem depois. Acompanhamos a pessoa presa ou investigada desde a delegacia e a audiência de custódia, pedimos a liberdade e conduzimos a defesa até a decisão final.",
    topics: ["Prisão em flagrante e audiência de custódia", "Habeas corpus e pedido de liberdade", "Inquérito policial e processo criminal", "Tribunal do Júri"],
    msg: "Olá, Dr. Charles. Preciso de ajuda urgente em um caso criminal.",
  },
  {
    area: "Direito Trabalhista",
    pain: "Demissão injusta, verbas não pagas, acidente de trabalho",
    text: "Se você saiu da empresa sem receber tudo, trabalhou horas extras sem pagamento ou se acidentou no serviço, a lei tem prazo para cobrar. Analisamos seu caso e dizemos o que você tem a receber.",
    topics: ["Verbas rescisórias e FGTS", "Horas extras e adicionais", "Rescisão indireta", "Acidente e doença do trabalho"],
    msg: "Olá, Dr. Charles. Quero analisar meus direitos trabalhistas.",
  },
  {
    area: "Direito Previdenciário",
    pain: "Aposentadoria negada, benefício cortado ou pensão recusada",
    text: "A negativa do INSS nem sempre é o fim. Muitas vezes há erro no cálculo, tempo de contribuição não reconhecido ou documento faltando. Revisamos seu histórico e entramos com o recurso ou a ação cabível.",
    topics: ["Aposentadoria por tempo, idade e especial", "Auxílio por incapacidade e BPC/LOAS", "Pensão por morte", "Revisão de benefício e correção do CNIS"],
    msg: "Olá, Dr. Charles. O INSS negou meu benefício e quero avaliar o que fazer.",
  },
  {
    area: "Direito Cível",
    pain: "Ser processado, cobrar uma dívida ou proteger o patrimônio",
    text: "Contratos descumpridos, cobranças, indenizações, herança e disputas de família. Orientamos antes do problema virar processo e, quando já virou, defendemos seu interesse com estratégia e objetividade.",
    topics: ["Contratos e cobranças", "Indenização por danos", "Família, herança e inventário", "Posse, imóveis e vizinhança"],
    msg: "Olá, Dr. Charles. Preciso de orientação sobre um problema cível.",
  },
];
---

<section id="situacoes" class="on-light bg-paper text-ink">
  <div class="max-w-7xl mx-auto px-5 lg:px-8 py-20 lg:py-28">
    <div class="max-w-2xl">
      <h2 class="font-serif text-4xl sm:text-5xl font-semibold leading-[1.1] tracking-tight">
        Qual problema você precisa resolver agora?
      </h2>
      <p class="mt-5 text-lg text-[#454B58] leading-relaxed">
        Atuamos em quatro áreas. Em todas, você fala direto com o advogado responsável pelo seu caso.
      </p>
    </div>

    <div class="mt-14 border-t-2 border-ink">
      {areas.map((a) => (
        <article class="grid grid-cols-1 lg:grid-cols-12 gap-6 lg:gap-12 py-10 border-b border-ink/20">
          <div class="lg:col-span-4">
            <p class="text-sm font-semibold text-vinho">{a.area}</p>
            <h3 class="mt-2 font-serif text-2xl sm:text-[1.7rem] font-semibold leading-snug">{a.pain}</h3>
          </div>

          <div class="lg:col-span-5">
            <p class="text-[17px] leading-[1.7] text-[#2B303B] max-w-[60ch]">{a.text}</p>
            <ul class="mt-5 grid sm:grid-cols-2 gap-x-6 gap-y-2 text-[15px] text-[#454B58]">
              {a.topics.map((t) => <li class="pl-4 relative before:absolute before:left-0 before:top-[0.7em] before:w-2 before:h-px before:bg-vinho">{t}</li>)}
            </ul>
          </div>

          <div class="lg:col-span-3 lg:text-right">
            <a
              href={wa(a.msg)}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center justify-center px-5 py-3 border-2 border-ink text-ink font-semibold text-[15px] hover:bg-ink hover:text-white transition-colors active:translate-y-px"
            >
              Falar sobre meu caso
            </a>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
