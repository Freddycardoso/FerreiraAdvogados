---
// src/components/Navbar.astro
const phone = "(35) 99753-3336";
const whatsappUrl = "https://wa.me/5535997533336?text=Ol%C3%A1%2C%20Dr.%20Charles.%20Vim%20pelo%20site%20e%20preciso%20de%20orienta%C3%A7%C3%A3o%20jur%C3%ADdica.";
---

<header class="sticky top-0 z-50 bg-ink border-b border-white/15">
  <div class="max-w-7xl mx-auto px-5 lg:px-8 h-20 flex items-center justify-between gap-6">
    <a href="#" aria-label="Ferreira Advogados - início" class="shrink-0">
      <img
        src="/images/logo-ferreira-transparent.png"
        alt="Ferreira Advogados"
        class="h-16 w-auto"
        width="190"
        height="64"
        fetchpriority="high"
      />
    </a>

    <nav aria-label="Principal" class="hidden lg:flex items-center gap-8 text-sm font-medium text-prata">
      <a href="#situacoes" class="hover:text-white transition-colors">Qual é o seu caso</a>
      <a href="#como-funciona" class="hover:text-white transition-colors">Como funciona</a>
      <a href="#advogado" class="hover:text-white transition-colors">O advogado</a>
      <a href="#contato" class="hover:text-white transition-colors">Contato</a>
    </nav>

    <div class="flex items-center gap-4">
      <a href={`tel:+5535997533336`} class="hidden md:block text-sm font-semibold text-white tabular-nums hover:text-prata transition-colors">
        {phone}
      </a>
      <a
        href={whatsappUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center justify-center px-4 sm:px-5 py-2.5 bg-vinho hover:bg-vinhoescuro text-white text-sm font-semibold transition-colors active:translate-y-px"
      >
        Falar com advogado
      </a>
    </div>
  </div>
</header>
