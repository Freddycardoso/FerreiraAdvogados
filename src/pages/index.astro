---
// src/pages/index.astro — Single-Page: Ferreira Advogados
const whatsappNumber = "5535997533336";
const whatsappUrl = `https://wa.me/${whatsappNumber}?text=Ol%C3%A1%2C%20Dr.%20Charles.%20Vim%20pelo%20site%20e%20gostaria%20de%20agendar%20uma%20consulta%20jur%C3%ADdica.`;
const wa = (msg: string) => `https://wa.me/${whatsappNumber}?text=${encodeURIComponent(msg)}`;

const title = "Advogado em Passos - MG | Criminal, Trabalhista, Cível e Previdenciário | Ferreira Advogados";
const description = "Defesa técnica em Passos - MG e região: Direito Criminal, Trabalhista, Cível e Previdenciário. Dr. Charles Santos Ferreira (OAB/MG 91.989). Atendimento personalizado e sigiloso.";
const canonicalURL = new URL(Astro.url.pathname, Astro.site || "https://ferreiraadvogados.com.br");

const schemaData = {
  "@context": "https://schema.org",
  "@type": "LegalService",
  "name": "Ferreira Advogados",
  "telephone": "+55-35-99753-3336",
  "address": { "@type": "PostalAddress", "addressLocality": "Passos", "addressRegion": "MG", "addressCountry": "BR" },
  "founder": { "@type": "Person", "name": "Dr. Charles Santos Ferreira", "jobTitle": "Advogado", "identifier": "OAB/MG 91.989" },
  "areaServed": { "@type": "AdministrativeArea", "name": "Passos e Região Sul de Minas Gerais" },
  "knowsAbout": ["Direito Criminal", "Direito Trabalhista", "Direito Cível", "Direito Previdenciário"]
};

const areas = [
  {
    area: "Direito Criminal",
    title: "Sua liberdade ou de um familiar foi ameaçada?",
    text: "Atuação emergencial em inquéritos e processos penais. A intervenção técnica nas primeiras horas é fundamental para evitar prisões arbitrárias.",
    msg: "Olá, Dr. Charles. Gostaria de analisar um caso de Direito Criminal.",
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z" />`,
  },
  {
    area: "Direito Trabalhista",
    title: "Teve direitos suprimidos no ambiente de trabalho?",
    text: "Rescisões injustas, horas extras não pagas ou assédio. Analisamos seu caso para buscar a reparação de todas as verbas negadas.",
    msg: "Olá, Dr. Charles. Gostaria de analisar um caso de Direito Trabalhista.",
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M20.25 14.15v4.25c0 1.094-.787 2.036-1.872 2.18-2.087.277-4.216.42-6.378.42s-4.291-.143-6.378-.42c-1.085-.144-1.872-1.086-1.872-2.18v-4.25m16.5 0a2.18 2.18 0 00.75-1.661V8.706c0-1.081-.768-2.015-1.837-2.175a48.114 48.114 0 00-3.413-.387m4.5 8.006c-.194.165-.42.295-.673.38A23.978 23.978 0 0112 15.75c-2.648 0-5.195-.429-7.577-1.22a2.016 2.016 0 01-.673-.38m0 0A2.18 2.18 0 013 12.489V8.706c0-1.081.768-2.015 1.837-2.175a48.111 48.111 0 013.413-.387m7.5 0V5.25A2.25 2.25 0 0013.5 3h-3a2.25 2.25 0 00-2.25 2.25v.894m7.5 0a48.667 48.667 0 00-7.5 0M12 12.75h.008v.008H12v-.008z" />`,
  },
  {
    area: "Direito Cível",
    title: "Enfrentando prejuízos financeiros ou quebra de contratos?",
    text: "Blindagem patrimonial, resolução de conflitos civis e busca por indenizações justas frente a danos materiais e morais.",
    msg: "Olá, Dr. Charles. Gostaria de analisar um caso de Direito Cível.",
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m0 12.75h7.5m-7.5 3H12M10.5 2.25H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z" />`,
  },
  {
    area: "Direito Previdenciário",
    title: "O INSS negou seu benefício ou aposentadoria?",
    text: "Desburocratizamos o sistema previdenciário para assegurar que seus anos de contribuição sejam devidamente reconhecidos e pagos.",
    msg: "Olá, Dr. Charles. Gostaria de analisar um caso de Direito Previdenciário.",
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z" />`,
  },
];

const whatsappIcon = `<path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/>`;
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#020617" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content="pt_BR" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,500;0,6..72,600;0,6..72,700&family=Libre+Franklin:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />

    <script type="application/ld+json" set:html={JSON.stringify(schemaData)} />

    <style is:global>
      html { scroll-behavior: smooth; scroll-padding-top: 5.5rem; }
      body { font-family: 'Libre Franklin', system-ui, sans-serif; }
      .font-display { font-family: 'Newsreader', Georgia, serif; }
      :focus-visible { outline: 2px solid #e2e8f0; outline-offset: 3px; }

      /* Fade-in + slide-up (ativado via IntersectionObserver) */
      .reveal {
        opacity: 0;
        transform: translateY(24px);
        transition: opacity 700ms cubic-bezier(0.22, 1, 0.36, 1), transform 700ms cubic-bezier(0.22, 1, 0.36, 1);
        transition-delay: var(--reveal-delay, 0ms);
      }
      .reveal.is-visible { opacity: 1; transform: none; }

      @media (prefers-reduced-motion: reduce) {
        html { scroll-behavior: auto; }
        .reveal { opacity: 1; transform: none; transition: none; }
      }

      /* Animação suave para o accordion (FAQ) usando CSS moderno (@starting-style) */
      details > .faq-content {
        transition: opacity 400ms ease-out, transform 400ms ease-out;
        opacity: 0;
        transform: translateY(-8px);
      }
      details[open] > .faq-content {
        opacity: 1;
        transform: translateY(0);
      }
      @starting-style {
        details[open] > .faq-content {
          opacity: 0;
          transform: translateY(-8px);
        }
      }
      /* Remove a seta default do summary (Safari/Chrome) */
      details summary::-webkit-details-marker {
        display: none;
      }
    </style>
    <noscript><style>.reveal { opacity: 1 !important; transform: none !important; }</style></noscript>
  </head>

  <body class="bg-slate-950 text-slate-300 antialiased selection:bg-slate-700 selection:text-white">

    <!-- 1. HEADER FIXO -->
    <header class="fixed top-0 inset-x-0 z-50 bg-slate-950/70 backdrop-blur-xl border-b border-white/10">
      <div class="max-w-7xl mx-auto px-5 lg:px-8 h-20 flex items-center justify-between gap-6">
        <a href="#inicio" aria-label="Ferreira Advogados - início" class="shrink-0">
          <img src="/images/logo-ferreira-transparent.png" alt="Ferreira Advogados" class="h-16 w-auto" width="190" height="64" />
        </a>

        <nav aria-label="Principal" class="hidden md:flex items-center gap-9 text-sm font-medium text-slate-300">
          <a href="#areas" class="hover:text-white transition-colors">Áreas de Atuação</a>
          <a href="#especialista" class="hover:text-white transition-colors">O Especialista</a>
          <a href="#contato" class="hover:text-white transition-colors">Contato</a>
        </nav>

        <a
          href={whatsappUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 px-4 py-2 text-sm font-medium text-emerald-50 border border-emerald-500/30 bg-emerald-600/20 hover:bg-emerald-600/40 rounded-md transition-colors"
        >
          <svg class="w-4 h-4 text-emerald-500" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" set:html={whatsappIcon} />
          WhatsApp
        </a>
      </div>
    </header>

    <main>

      <!-- 2. HERO -->
      <section id="inicio" class="pt-32 pb-20 lg:pt-40 lg:pb-28">
        <div class="max-w-7xl mx-auto px-5 lg:px-8 grid grid-cols-1 lg:grid-cols-12 gap-14 lg:gap-16 items-center">

          <div class="lg:col-span-7 reveal">
            <div class="mb-6 inline-flex items-center gap-2 px-3 py-1 rounded-full bg-slate-800/50 border border-slate-700/50">
              <span class="w-2 h-2 rounded-full bg-slate-300 animate-pulse"></span>
              <span class="text-[13px] font-medium text-slate-300 tracking-wide">Plantão Criminal Ativo em Passos - MG</span>
            </div>
            <h1 class="font-display text-4xl sm:text-5xl lg:text-[3.7rem] font-semibold text-white leading-[1.08] tracking-tight">
              A Barreira Legal Entre Seu Patrimônio, Sua Liberdade e o Estado.
            </h1>
            <p class="mt-7 max-w-xl text-lg text-slate-300 leading-relaxed">
              Com sede em Passos e atuação em todo o Sul de Minas, a Ferreira Advogados oferece defesa combativa e estratégica contra arbitrariedades, abusos trabalhistas e riscos patrimoniais.
            </p>

            <div class="mt-10">
              <a
                href={whatsappUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center justify-center gap-3 px-8 py-4 text-base font-semibold text-white bg-gradient-to-b from-emerald-600 to-emerald-800 hover:from-emerald-500 hover:to-emerald-700 rounded-md shadow-lg shadow-emerald-900/30 transition-all active:scale-[0.98] ring-1 ring-emerald-500/30"
              >
                <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" set:html={whatsappIcon} />
                Falar com um Advogado Imediatamente
              </a>
            </div>

            <p class="mt-6 text-sm text-slate-400">
              Dr. Charles Santos Ferreira · OAB/MG 91.989 · Passos - MG
            </p>
          </div>

          <div class="lg:col-span-5 reveal" style="--reveal-delay: 150ms;">
            <div class="relative mx-auto max-w-sm lg:max-w-none">
              <div class="rounded-xl overflow-hidden border border-slate-700 bg-slate-900 aspect-[4/5] shadow-2xl shadow-black/50">
                <img
                  src="/images/dr-charles-portrait.jpg"
                  alt="Dr. Charles Santos Ferreira - Advogado em Passos MG"
                  class="w-full h-full object-cover grayscale-[0.2] contrast-[1.05]"
                  width="800"
                  height="1000"
                  loading="eager"
                />
              </div>
              <div class="absolute -bottom-px inset-x-0 h-1/2 bg-gradient-to-t from-slate-950 to-transparent rounded-b-xl pointer-events-none"></div>
              
              <!-- Badge de Autoridade -->
              <div class="absolute bottom-6 left-6 right-6 p-4 rounded-lg bg-slate-950/80 backdrop-blur-md border border-white/10 flex items-center justify-between">
                <div>
                  <p class="text-sm font-semibold text-white">Dr. Charles Santos Ferreira</p>
                  <p class="text-xs text-slate-400 mt-0.5">OAB/MG 91.989</p>
                </div>
                <div class="text-right">
                  <p class="text-xs text-slate-400">Atendimento</p>
                  <p class="text-sm font-semibold text-white mt-0.5">Sigilo Absoluto</p>
                </div>
              </div>
            </div>
          </div>

        </div>
      </section>

      <!-- 3. ÁREAS DE ATUAÇÃO -->
      <section id="areas" class="py-20 lg:py-28 border-t border-white/10 bg-slate-900/40">
        <div class="max-w-7xl mx-auto px-5 lg:px-8">
          <div class="max-w-2xl reveal">
            <h2 class="font-display text-3xl sm:text-4xl lg:text-5xl font-semibold text-white leading-[1.12] tracking-tight">
              Atuação Especializada
            </h2>
            <p class="mt-5 text-lg text-slate-400 leading-relaxed">
              Cada crise exige uma resposta técnica imediata e precisa. Identifique o cenário que se aproxima do seu caso.
            </p>
          </div>

          <div class="mt-14 border-t border-slate-800">
            {areas.map((a, i) => (
              <article
                class="reveal group flex flex-col md:flex-row md:items-center gap-6 lg:gap-12 py-10 border-b border-slate-800 transition-colors hover:bg-slate-900/40 -mx-5 px-5 lg:-mx-8 lg:px-8"
                style={`--reveal-delay: ${i * 90}ms;`}
              >
                <div class="md:w-1/3 shrink-0 flex items-start gap-5">
                  <div class="mt-1 opacity-60 group-hover:opacity-100 transition-all duration-300 ease-out group-hover:scale-110">
                    <svg class="w-6 h-6 text-slate-300 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true" set:html={a.icon} />
                  </div>
                  <div>
                    <h3 class="font-display text-2xl font-semibold text-white leading-snug transition-transform duration-300 ease-out group-hover:translate-x-1.5">
                      {a.area}
                    </h3>
                    {a.area === "Direito Criminal" && (
                      <span class="mt-2 inline-flex items-center gap-1.5 px-2.5 py-1 text-[11px] font-bold uppercase tracking-widest text-slate-950 bg-slate-300 rounded-sm">
                        <span class="w-1.5 h-1.5 rounded-full bg-red-600 animate-pulse"></span>
                        Plantão 24h
                      </span>
                    )}
                  </div>
                </div>
                <div class="md:w-2/3 flex flex-col sm:flex-row gap-8 sm:items-center justify-between">
                  <div class="max-w-lg">
                    <p class="text-[17px] text-slate-200 font-medium mb-3">{a.title}</p>
                    <p class="text-sm text-slate-400 leading-relaxed">{a.text}</p>
                  </div>
                  <a
                    href={wa(a.msg)}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="shrink-0 inline-flex items-center justify-center p-4 rounded-full bg-slate-800 text-slate-300 group-hover:bg-white group-hover:text-slate-950 transition-all duration-300 ease-out group-hover:scale-105 group-hover:shadow-[0_0_20px_rgba(255,255,255,0.1)]"
                    aria-label={`Falar sobre ${a.area}`}
                  >
                    <svg class="w-5 h-5 transition-transform duration-300 ease-out group-hover:translate-x-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                    </svg>
                  </a>
                </div>
              </article>
            ))}
          </div>
        </div>
      </section>

      <!-- 4. O ESPECIALISTA -->
      <section id="especialista" class="py-20 lg:py-28 border-t border-white/10">
        <div class="max-w-7xl mx-auto px-5 lg:px-8 grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16">
          <div class="lg:col-span-5 reveal">
            <h2 class="font-display text-3xl sm:text-4xl lg:text-5xl font-semibold text-white leading-[1.12] tracking-tight">
              Liderança Técnica e Compromisso com a Verdade.
            </h2>
          </div>

          <div class="lg:col-span-7 reveal" style="--reveal-delay: 120ms;">
            <div class="space-y-5 text-[17px] text-slate-300 leading-[1.75] max-w-[62ch]">
              <p>
                A Ferreira Advogados é conduzida pelo <strong class="font-semibold text-white">Dr. Charles Santos Ferreira (OAB/MG 91.989)</strong>, com atuação focada em Passos e em todo o Sul de Minas Gerais.
              </p>
              <p>
                Aqui não há advocacia de massa. Cada caso recebe atendimento personalizado: você fala diretamente com o advogado responsável, que estuda os fatos, os documentos e os prazos antes de definir a estratégia.
              </p>
              <p>
                Tudo o que for compartilhado está protegido por sigilo profissional absoluto. A condução de cada demanda une combatividade técnica, rigor processual e respeito às regras éticas da advocacia.
              </p>
            </div>

            <dl class="mt-10 grid sm:grid-cols-3 gap-6 border-t border-slate-700 pt-6 text-sm">
              <div>
                <dt class="font-medium text-slate-400">Registro</dt>
                <dd class="mt-1 text-white">OAB/MG 91.989</dd>
              </div>
              <div>
                <dt class="font-medium text-slate-400">Sede</dt>
                <dd class="mt-1 text-white">Passos - MG</dd>
              </div>
              <div>
                <dt class="font-medium text-slate-400">Compromisso</dt>
                <dd class="mt-1 text-white">Sigilo e atendimento personalizado</dd>
              </div>
            </dl>
          </div>
        </div>
      </section>

      <!-- 5. FAQ / DÚVIDAS FREQUENTES -->
      <section id="faq" class="py-20 lg:py-28 border-t border-white/10 bg-slate-900/40">
        <div class="max-w-7xl mx-auto px-5 lg:px-8 grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-start">
          <div class="lg:col-span-5 reveal">
            <h2 class="font-display text-3xl sm:text-4xl font-semibold text-white leading-[1.12] tracking-tight">
              Dúvidas Frequentes
            </h2>
            <p class="mt-5 text-lg text-slate-400 leading-relaxed">
              Respostas diretas sobre nosso formato de trabalho e atendimento na região de Passos.
            </p>
          </div>
          
          <div class="lg:col-span-7 reveal flex flex-col gap-4">
            <details class="group border border-slate-700 bg-slate-800/40 rounded-lg open:bg-slate-800/80 transition-colors">
              <summary class="flex items-center justify-between p-6 cursor-pointer list-none font-semibold text-white">
                Como funciona a primeira consulta?
                <svg class="w-5 h-5 text-slate-400 group-open:rotate-180 transition-transform duration-300 ease-out" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" /></svg>
              </summary>
              <div class="faq-content">
                <div class="px-6 pb-6 text-slate-300 leading-relaxed">
                  A primeira consulta é uma análise técnica do seu caso. Nela, o Dr. Charles avalia os fatos, documentos disponíveis e traça o cenário real dos riscos e possibilidades jurídicas antes de propor qualquer intervenção.
                </div>
              </div>
            </details>
            
            <details class="group border border-slate-700 bg-slate-800/40 rounded-lg open:bg-slate-800/80 transition-colors">
              <summary class="flex items-center justify-between p-6 cursor-pointer list-none font-semibold text-white">
                Vocês atendem apenas em Passos - MG?
                <svg class="w-5 h-5 text-slate-400 group-open:rotate-180 transition-transform duration-300 ease-out" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" /></svg>
              </summary>
              <div class="faq-content">
                <div class="px-6 pb-6 text-slate-300 leading-relaxed">
                  Nossa sede física está localizada em Passos, mas atuamos ativamente em todo o Sul de Minas Gerais, prestando atendimento presencial e também por videoconferência, com total garantia de sigilo profissional.
                </div>
              </div>
            </details>
            
            <details class="group border border-slate-700 bg-slate-800/40 rounded-lg open:bg-slate-800/80 transition-colors">
              <summary class="flex items-center justify-between p-6 cursor-pointer list-none font-semibold text-white">
                Como funciona o Plantão Criminal?
                <svg class="w-5 h-5 text-slate-400 group-open:rotate-180 transition-transform duration-300 ease-out" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" /></svg>
              </summary>
              <div class="faq-content">
                <div class="px-6 pb-6 text-slate-300 leading-relaxed">
                  O Plantão Criminal é um serviço de pronta-resposta para emergências legais (prisões em flagrante, cumprimento de mandados). O escritório atua imediatamente para assegurar que nenhum direito seja violado pelas autoridades.
                </div>
              </div>
            </details>
          </div>
        </div>
      </section>

      <!-- 6. CTA FINAL -->
      <section id="contato" class="py-20 lg:py-28 border-t border-white/10">
