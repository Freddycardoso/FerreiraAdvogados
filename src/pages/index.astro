    <style is:global>
      html { scroll-behavior: smooth; scroll-padding-top: 5.5rem; }
      body { font-family: 'Libre Franklin', system-ui, sans-serif; }
      .font-display { font-family: 'Newsreader', Georgia, serif; }
      :focus-visible { outline: 2px solid #e2e8f0; outline-offset: 3px; }

      /* Fade-in + slide-up (ativado via IntersectionObserver) */
      .reveal {
        opacity: 0;
        transform: translateY(24px);
        transition: opacity 700ms cubic-bezier(0.22, 1, 0.36, 1), transform 700ms cubic-bezier(0.22, 1, 0.36, 1);
        transition-delay: var(--reveal-delay, 0ms);
      }
      .reveal.is-visible { opacity: 1; transform: none; }

      @media (prefers-reduced-motion: reduce) {
        html { scroll-behavior: auto; }
        .reveal { opacity: 1; transform: none; transition: none; }
      }

      /* Animação suave para o accordion (FAQ) usando CSS moderno (@starting-style) */
      details > .faq-content {
        transition: opacity 400ms ease-out, transform 400ms ease-out;
        opacity: 0;
        transform: translateY(-8px);
      }
      details[open] > .faq-content {
        opacity: 1;
        transform: translateY(0);
      }
      @starting-style {
        details[open] > .faq-content {
          opacity: 0;
          transform: translateY(-8px);
        }
      }
      /* Remove a seta default do summary (Safari/Chrome) */
      details summary::-webkit-details-marker {
        display: none;
      }
    </style>
    <noscript><style>.reveal { opacity: 1 !important; transform: none !important; }</style></noscript>
  </head>

